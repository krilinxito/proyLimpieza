# ============================================================
#  Copiá este archivo a .env y ajustá los valores.
#  .env está en .gitignore y NUNCA se commitea.
# ============================================================

# ---------- Postgres ----------
POSTGRES_USER=lavanderia
POSTGRES_PASSWORD=cambiame_en_local
POSTGRES_DB=lavanderia
# Si el puerto ya está ocupado por otro Postgres, cambialo acá (ej. 5434).
POSTGRES_PORT=5432

# ---------- PowerSync ----------
# Tag fijo a propósito: `latest` puede cambiar bajo los pies del equipo
# y romper la config de docker/powersync/. Verificado con esta versión.
POWERSYNC_TAG=1.25.0
POWERSYNC_PORT=8080
# PowerSync guarda su estado en la base `powersync_storage`, en el mismo
# Postgres pero separada de la del negocio. La crea docker/postgres/
# al inicializar el volumen; no hace falta configurar nada más.

# Secreto compartido con el que el backend firma los JWT y PowerSync los
# verifica (HS256, solo para desarrollo — en producción va RS256 + jwks_uri).
#
# Hay UN solo secreto, guardado acá en base64url. El backend lo decodifica a
# bytes antes de firmar. Generalo así:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PS_JWT_SECRET_B64=reemplazame_con_un_secreto_generado
PS_JWT_AUDIENCE=lavanderia

# ---------- Backend (host, no Docker) ----------
# El backend lee este mismo archivo desde la raíz del repo, no una copia suya.
NODE_ENV=development
PORT=4000
# El puerto de acá tiene que ser el MISMO que POSTGRES_PORT: si lo cambiaste
# arriba por un choque, cambialo también en esta línea o el backend se conectará
# al Postgres equivocado (o a ninguno).
DATABASE_URL=postgresql://lavanderia:cambiame_en_local@localhost:5432/lavanderia
# El backend lee PS_JWT_SECRET_B64 (arriba) y lo decodifica: NO definas otro
# secreto acá o los tokens que emita el backend no los aceptará PowerSync.
# El `aud` del token debe coincidir con PS_JWT_AUDIENCE.
# 2-3 días: es el presupuesto de trabajo sin internet, no una medida de
# seguridad. En cada reconexión se verifica el estado del usuario y se renueva,
# reiniciando el plazo. Ver CLAUDE.md sección 6.
JWT_EXPIRES_IN=3d
# El token de PowerSync dura MENOS: PowerSync no acepta tokens de más de 24 h
# (los rechaza con 401 y la tablet no baja datos). Por defecto 12h; el backend no
# arranca si se pone más de 24h. Sin internet no se usa: al volver la conexión,
# la app pide uno nuevo a /api/auth/renovar con el de la API (SPEC-ALE186-025).
PS_JWT_EXPIRES_IN=12h
# Desde qué direcciones puede un navegador llamar a la API (CORS), separadas por
# comas. Si no está, vale el frontend de desarrollo (http://localhost:5173); en
# producción es OBLIGATORIA, y sin ella el backend no arranca (SPEC-ALE186-023).
# Si corrés el frontend en otro puerto, agregalo acá o el navegador bloqueará las
# llamadas.
CORS_ORIGENES=http://localhost:5173
# Tiempos límite de la conexión a Postgres, en milisegundos. Una consulta que
# pasa de DB_STATEMENT_TIMEOUT_MS la corta la base; si no se consigue conexión en
# DB_CONNECTION_TIMEOUT_MS, el pedido falla en vez de quedarse esperando.
DB_STATEMENT_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# ---------- Semilla inicial (SPEC-ALE186-002) ----------
# El sistema nace sin usuarios, y sin usuarios no se puede entrar. Esto es lo
# que crea la primera sucursal y el primer ADMIN:
#   npm run seed --workspace backend
# La contraseña NO tiene valor por defecto a propósito: elegila vos. El resto
# se puede dejar como está.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NOMBRE=Administrador
SEED_SUCURSAL=Sucursal Central

# ---------- Frontend (host, no Docker) ----------
VITE_API_URL=http://localhost:4000
VITE_POWERSYNC_URL=http://localhost:8080
# Ambas URLs deben usar los mismos puertos configurados arriba.
# ---------- Demo para el cliente con ngrok (SPEC-KRILINXI-064) ----------
# NO va en este archivo: es una variable del comando, no de la app. Se pasa al correr
#   DEMO_URL_PUBLICA=https://tu-dominio.ngrok-free.app npm run demo
# Es la dirección https que te da ngrok, sin ruta. Con ella, npm run demo compila la app con
# VITE_API_URL=<esa dirección> y VITE_POWERSYNC_URL=<esa dirección>/powersync, así que no hace
# falta tocar las dos de arriba ni CORS_ORIGENES (la app y la API comparten dirección).
# Guía completa: CLAUDE.md, sección 11.
