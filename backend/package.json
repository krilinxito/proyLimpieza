{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API Express del sistema de lavandería",
  "scripts": {
    "dev": "nodemon",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
